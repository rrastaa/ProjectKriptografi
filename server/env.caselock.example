# Pengaturan CASELOCK — salin/gabungkan ke file .env Laravel (backend/.env)
# scripts/setup-backend.sh melakukannya secara otomatis.

# --- Database PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=caselock
DB_USERNAME=caselock
DB_PASSWORD=ganti-password-ini

# --- Hashing password: Argon2id ---
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# --- Infrastruktur sederhana (tanpa tabel session/queue tambahan) ---
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# --- CASELOCK ---
# Diisi otomatis oleh: php artisan caselock:generate-key --write
CASELOCK_MASTER_KEY=

# WebAuthn: RP ID = domain (tanpa skema/port); ORIGINS = alamat frontend persis (boleh lebih dari satu, pisah koma)
CASELOCK_RP_ID=localhost
CASELOCK_RP_NAME=CASELOCK
CASELOCK_ORIGINS=http://localhost:5173

CASELOCK_TOKEN_TTL=480
CASELOCK_MAX_FILE_MB=25
